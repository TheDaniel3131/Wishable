# Wishable configuration (example)
#
# Copy this file to `.env` and fill in your values. `.env` is gitignored so your
# real config never gets committed. The run scripts (`scripts/run.ps1` /
# `scripts/run.sh`) read this file and forward each KEY=VALUE as a Flutter
# `--dart-define`, because Flutter resolves `String.fromEnvironment` at COMPILE
# time — a plain runtime `.env` cannot feed into it.
#
# Leave a value empty (or delete the line) to use the app's built-in default.

# PocketBase backend base URL. Empty = remote accounts/sync disabled; the app
# runs fully offline. Example local server: http://127.0.0.1:8090
WISHABLE_PB_URL=
