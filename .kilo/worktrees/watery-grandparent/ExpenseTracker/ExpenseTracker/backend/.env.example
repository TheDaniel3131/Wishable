# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moneytracker
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES=30d

# ── Anthropic (Claude Vision for receipt scanning) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
