{
    "manifest_version": 3,
    "name": "Auto Refresh Timer",
    "version": "1.0",
    "description": "A modern, dark-themed auto-refresher for specific tabs.",
    "permissions": [
      "alarms",
      "activeTab",
      "scripting"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    }
  }